+private struct FfaBotChannelView: View {
+    @Environment(\.openURL) private var openURL
+    @StateObject private var channel = FfaBotChannel()
+    @State private var draft = ""
+    @State private var attachment: PhotosPickerItem?
+
+    var body: some View {
+        List {
+            if let message = channel.message { Text(message).foregroundStyle(.secondary) }
+            if channel.busy { ProgressView() }
+            if let account = channel.account {
+                Section("当前星邮号") {
+                    Text(account["nickname"] as? String ?? account["humanId"] as? String ?? "")
+                    ForEach(channel.bots, id: \.id) { bot in
+                        Button {
+                            attachment = nil
+                            Task { await channel.select(bot.id) }
+                        } label: {
+                            Label(bot.label, systemImage: bot.id == channel.activeBot ? "checkmark.circle" : "person.crop.circle")
+                        }.disabled(channel.busy || bot.id == channel.activeBot)
+                    }
+                    if channel.bots.isEmpty {
+                        Link("在星邮绑定 bot", destination: URL(string: "https://starpost.com.cn/app/settings")!)
+                    }
+                    Button("退出此端登录", role: .destructive) {
+                        draft = ""
+                        attachment = nil
+                        Task { await channel.signOut() }
+                    }.disabled(channel.busy)
+                }
+                if channel.activeBot != nil {
+                    Section("专属频道") {
+                        Button("刷新记录") { Task { await channel.refresh() } }.disabled(channel.busy)
+                        if channel.hasEarlier {
+                            Button("更早记录") { Task { await channel.earlier() } }.disabled(channel.busy)
+                        }
+                        ForEach(channel.messages, id: \.id) { item in
+                            VStack(alignment: .leading, spacing: 6) {
+                                Text(item.sender).font(.caption).foregroundStyle(.secondary)
+                                if !item.text.isEmpty { Text(item.text) }
+                                if let image = item.image { Image(uiImage: image).resizable().scaledToFit().frame(maxHeight: 240) }
+                                if item.hasAudio {
+                                    Button("播放语音") { Task { await channel.play(item.id) } }.disabled(channel.busy)
+                                }
+                            }
+                        }
+                        TextField("给 bot 写点什么", text: $draft)
+                        PhotosPicker(selection: $attachment, matching: .images) {
+                            Label(attachment == nil ? "附上图片" : "已选择图片", systemImage: "photo")
+                        }.disabled(channel.busy)
+                        if attachment != nil {
+                            Button("移除图片") { attachment = nil }.disabled(channel.busy)
+                        }
+                        Button("发送") {
+                            let text = draft, photo = attachment
+                            Task {
+                                if await channel.send(text, photo: photo) {
+                                    if draft == text { draft = "" }
+                                    if attachment == photo { attachment = nil }
+                                }
+                            }
+                        }.disabled(channel.busy || (draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && attachment == nil))
+                    }
+                }
+            } else {
+                Section {
+                    if let link = channel.authorizationURL {
+                        Button("继续浏览器授权") { openURL(link) }.disabled(channel.busy)
+                        Button("完成登录") { Task { await channel.complete() } }.disabled(channel.busy)
+                        Button("取消") { channel.cancel() }.disabled(channel.busy)
+                    } else {
+                        Button("使用 FFA Hub 登录") {
+                            Task { if let url = await channel.begin() { openURL(url) } }
+                        }.disabled(channel.busy)
+                    }
+                    Link("注册 FFA Hub 账号", destination: URL(string: "https://ffahub.net/?screen=register")!)
+                } footer: {
+                    Text("日常对话与星邮共用专属频道。连接 Coo 和本机记录仍从原页面访问。")
+                }
+            }
+        }.navigationTitle("FFA Hub · 我的 bot").task { await channel.refresh() }.onDisappear { channel.stopAudio() }
+    }
+}
