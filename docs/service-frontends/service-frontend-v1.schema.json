{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coodock:service-frontend:v1",
  "title": "CooDock preloaded native service frontend manifest v1",
  "description": "A build-time handoff contract. This manifest does not download or execute code and does not contain credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "services"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/service" } }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "kind"],
      "properties": {
        "state": { "enum": ["bundled", "integrating", "awaiting-upstream", "planned"] },
        "kind": { "enum": ["native-view", "native-activity", "native-window", "native-scene"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "minSdk": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      },
      "allOf": [{ "if": { "properties": { "state": { "const": "bundled" } } }, "then": { "required": ["entrypoint"] } }]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "world", "auth", "platforms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "world": {
          "type": "object", "additionalProperties": false, "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "backend": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "ownership": { "const": "service-operated" },
            "notes": { "type": "string" }
          }
        },
        "auth": {
          "type": "object", "additionalProperties": false,
          "required": ["providerId", "sessionKey"],
          "properties": {
            "providerId": { "type": "string", "minLength": 1 },
            "sessionKey": { "const": "serviceId+issuer+subject+botId" },
            "state": { "enum": ["pending-provider", "ready"] },
            "legacyLogin": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "platforms": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "android": { "$ref": "#/$defs/module" },
            "ios": { "$ref": "#/$defs/module" },
            "windows": { "$ref": "#/$defs/module" },
            "linux": { "$ref": "#/$defs/module" },
            "harmonyos": { "$ref": "#/$defs/module" }
          }
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
